": 626, "width": 1100, "height": 17, "strokeColor": "#64748b", "backgroundColor": "transparent", "text": "The hash is chained:  h(block) = H( h(parent) \u2016 tokens ),  so a hit means every token from position zero matches.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The hash is chained:  h(block) = H( h(parent) \u2016 tokens ),  so a hit means every token from position zero matches.", "lineHeight": 1.25, "autoResize": false}, {"roughness": 0, "seed": 1, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "frameId": null, "boundElements": null, "updated": 1, "link": null, "locked": false, "angle": 0, "opacity": 100, "strokeStyle": "solid", "fillStyle": "solid", "strokeWidth": 1.5, "roundness": null, "type": "text", "id": "t48", "x": 130, "y": 650, "width": 1100, "height": 17, "strokeColor": "#64748b", "backgroundColor": "transparent", "text": "Token ids are still compared on a hit, because hashes collide.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Token ids are still compared on a hit, because hashes collide.", "lineHeight": 1.25, "autoResize": false}, {"roughness": 0, "seed": 1, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "frameId": null, "boundElements": null, "updated": 1, "link": null, "locked": false, "angle": 0, "opacity": 100, "strokeStyle": "solid", "fillStyle": "solid", "strokeWidth": 1.5, "roundness": null, "type": "text", "id": "t49", "x": 130, "y": 674, "width": 1100, "height": 17, "strokeColor": "#64748b", "backgroundColor": "transparent", "text": "A partial block released before it is ever hashed goes straight back to FREE.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A partial block released before it is ever hashed goes straight back to FREE.", "lineHeight": 1.25, "autoResize": false}, {"ro